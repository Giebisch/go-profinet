{
  "comment": "Catalog of the GSDML elements and attributes go-profinet models. Written independently from public descriptions of GSDML (it contains no text of the PI schemas). Generator input for gsdml/zz_generated.go and gsdml/SCHEMA.md: go generate ./gsdml. Attributes are name:type, a trailing ! marks a required one, a trailing ~ one that is always written but may be empty. Children are element names; ? marks optional, * repeated, + one or more. Unknown elements and attributes of a document are preserved by the generated types.",
  "namespace": "http://www.profibus.com/GSDML/2003/11/DeviceProfile",
  "root": "ISO15745Profile",
  "versions": ["2.25", "2.3", "2.31", "2.32", "2.33", "2.34", "2.35", "2.4", "2.41", "2.42", "2.43", "2.44", "2.45"],
  "simpleTypes": {
    "string": {"doc": "Any text."},
    "token": {"doc": "A token without leading or trailing blanks.", "pattern": "^\\S(.*\\S)?$"},
    "ID": {"doc": "An identifier unique in the document.", "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]*$"},
    "IDRef": {"doc": "A reference to an ID.", "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]*$"},
    "Unsigned8": {"doc": "0..255 in decimal or 0x hexadecimal.", "uint": 8},
    "Unsigned16": {"doc": "0..65535 in decimal or 0x hexadecimal.", "uint": 16},
    "Unsigned32": {"doc": "0..4294967295 in decimal or 0x hexadecimal.", "uint": 32},
    "Unsigned16Hex": {"doc": "A 16-bit value in 0x hexadecimal.", "pattern": "^0[xX][0-9A-Fa-f]{1,4}$", "uint": 16},
    "Unsigned32Hex": {"doc": "A 32-bit value in 0x hexadecimal.", "pattern": "^0[xX][0-9A-Fa-f]{1,8}$", "uint": 32},
    "Boolean": {"doc": "true or false (also 1 or 0).", "enum": ["true", "false", "1", "0"]},
    "ValueList": {"doc": "Unsigned values and ranges separated by blanks: \"1..4 6\".", "pattern": "^\\s*[0-9]+(\\.\\.[0-9]+)?(\\s+[0-9]+(\\.\\.[0-9]+)?)*\\s*$"},
    "TokenList": {"doc": "Tokens separated by blanks or semicolons.", "pattern": "^[^\\s;]*([\\s;]+[^\\s;]+)*$"},
    "Version": {"doc": "A version of the form V<major>.<minor>.", "pattern": "^V[0-9]+\\.[0-9]+$"},
    "SoftwareRelease": {"doc": "A software release such as V1.2.3.", "pattern": "^\\S+$"},
    "DataType": {"doc": "The data type of a DataItem or Ref.", "enum": [
      "Bit", "BitArea", "Boolean", "Integer8", "Integer16", "Integer32", "Integer64",
      "Unsigned8", "Unsigned16", "Unsigned32", "Unsigned64", "Float32", "Float64",
      "Date", "TimeOfDay with date indication", "TimeOfDay without date indication",
      "TimeDifference with date indication", "TimeDifference without date indication",
      "NetworkTime", "NetworkTimeDifference", "VisibleString", "OctetString",
      "Unsigned8+Unsigned8", "Float32+Unsigned8", "Float32+Status8", "Float64+Status8",
      "Unsigned8_S", "OctetString_S", "Unsigned16_S", "Integer16_S", "Integer32_S", "Unsigned32_S",
      "N2", "N4", "V2", "L2", "R2", "T2", "T4", "D2", "E2", "C4", "X2", "X4", "Unipolar2.16",
      "OctetString2+Unsigned8", "UTF8String", "F_MessageTrailer4Byte", "F_MessageTrailer5Byte",
      "TimeStamp", "TimeStampDifference", "TimeStampDifferenceShort"]},
    "Consistency": {"doc": "The consistency of IO data.", "enum": ["Item consistency", "All items consistency"]},
    "StartupMode": {"doc": "The startup modes of an interface.", "pattern": "^(Legacy|Advanced)(;(Legacy|Advanced))*$"},
    "RTClasses": {"doc": "RT classes separated by blanks or semicolons.", "pattern": "^RT_CLASS_(1|2|3|UDP|STREAM_HI|STREAM_LO)([\\s;]+RT_CLASS_(1|2|3|UDP|STREAM_HI|STREAM_LO))*$"},
    "ConformanceClass": {"doc": "The PROFINET conformance class.", "enum": ["A", "B", "C", "D"]},
    "NetloadClass": {"doc": "The netload robustness class.", "enum": ["I", "II", "III"]},
    "MainFamily": {"doc": "The main device family.", "enum": ["General", "Drives", "Switching Devices", "I/O", "Valves", "Controllers", "HMI", "Encoders", "NC/RC", "Gateway", "PLCs", "Ident Systems", "PA Profiles", "Network Components", "Sensors"]},
    "Language": {"doc": "An ISO 639-1 language code.", "pattern": "^[a-z]{2}(-[A-Za-z]{2})?$"}
  },
  "elements": [
    {"name": "ISO15745Profile", "doc": "The document root.", "children": ["ProfileHeader", "ProfileBody"]},
    {"name": "ProfileHeader", "doc": "The ISO 15745 header that names the profile.", "children": ["ProfileIdentification", "ProfileRevision", "ProfileName", "ProfileSource", "ProfileClassID", "ISO15745Reference"]},
    {"name": "ProfileIdentification", "text": "string"},
    {"name": "ProfileRevision", "text": "string"},
    {"name": "ProfileName", "text": "string"},
    {"name": "ProfileSource", "text": "string"},
    {"name": "ProfileClassID", "text": "string"},
    {"name": "ISO15745Reference", "children": ["ISO15745Part", "ISO15745Edition", "ProfileTechnology"]},
    {"name": "ISO15745Part", "text": "string"},
    {"name": "ISO15745Edition", "text": "string"},
    {"name": "ProfileTechnology", "text": "string"},
    {"name": "ProfileBody", "children": ["DeviceIdentity", "DeviceFunction", "ApplicationProcess"]},
    {"name": "DeviceIdentity", "doc": "The vendor and device ID of the device family.", "attrs": ["VendorID:Unsigned16Hex!", "DeviceID:Unsigned16Hex!"], "children": ["InfoText", "VendorName"]},
    {"name": "InfoText", "attrs": ["TextId:IDRef!"]},
    {"name": "VendorName", "attrs": ["Value:token!"]},
    {"name": "DeviceFunction", "children": ["Family"]},
    {"name": "Family", "attrs": ["MainFamily:MainFamily!", "ProductFamily:token"]},
    {"name": "ApplicationProcess", "children": ["DeviceAccessPointList", "ModuleList?", "SubmoduleList?", "ValueList?", "ChannelDiagList?", "GraphicsList?", "CategoryList?", "ExternalTextList"]},
    {"name": "DeviceAccessPointList", "children": ["DeviceAccessPointItem+"]},
    {"name": "DeviceAccessPointItem", "doc": "A device access point: the head module in slot 0 with the interface and its capabilities.", "attrs": [
      "ID:ID!", "PNIO_Version:Version!", "PhysicalSlots:ValueList!", "ModuleIdentNumber:Unsigned32Hex!",
      "MinDeviceInterval:Unsigned16!", "DNS_CompatibleName:token!", "FixedInSlots:ValueList!", "ObjectUUID_LocalIndex:Unsigned16!",
      "RequiredSchemaVersion:Version", "ImplementationType:token", "MultipleWriteSupported:Boolean", "DeviceAccessSupported:Boolean!",
      "CheckDeviceID_Allowed:Boolean!", "NameOfStationNotTransferable:Boolean!", "LLDP_NoD_Supported:Boolean", "ResetToFactoryModes:ValueList",
      "SharedDeviceSupported:Boolean", "SharedInputSupported:Boolean", "NumberOfDeviceAccessAR:Unsigned16", "PrmBeginPrmEndSequenceSupported:Boolean",
      "AddressAssignment:TokenList", "PowerOnToCommReady:Unsigned32", "MaxSupportedRecordSize:Unsigned32", "WebServer:string", "AutoConfigurationSupported:Boolean"],
      "children": ["ModuleInfo", "CertificationInfo?", "SubslotList?", "IOConfigData", "UseableModules?", "VirtualSubmoduleList", "SystemDefinedSubmoduleList?", "Graphics?", "UseableSubmodules?"]},
    {"name": "ModuleInfo", "attrs": ["CategoryRef:IDRef", "SubCategory1Ref:IDRef"], "children": ["Name", "InfoText", "VendorName?", "OrderNumber?", "HardwareRelease?", "SoftwareRelease?"]},
    {"name": "Name", "attrs": ["TextId:IDRef!"]},
    {"name": "OrderNumber", "attrs": ["Value:token!"]},
    {"name": "HardwareRelease", "attrs": ["Value:token!"]},
    {"name": "SoftwareRelease", "attrs": ["Value:SoftwareRelease!"]},
    {"name": "CertificationInfo", "attrs": ["ConformanceClass:ConformanceClass!", "ApplicationClass:TokenList~", "NetloadClass:NetloadClass"]},
    {"name": "SubslotList", "children": ["SubslotItem+"]},
    {"name": "SubslotItem", "attrs": ["SubslotNumber:Unsigned16!", "TextId:IDRef!"]},
    {"name": "IOConfigData", "attrs": ["MaxInputLength:Unsigned16!", "MaxOutputLength:Unsigned16!", "MaxDataLength:Unsigned16", "ApplicationLengthIncludesIOxS:Boolean"]},
    {"name": "UseableModules", "children": ["ModuleItemRef+"]},
    {"name": "ModuleItemRef", "attrs": ["ModuleItemTarget:IDRef!", "AllowedInSlots:ValueList", "UsedInSlots:ValueList", "FixedInSlots:ValueList"]},
    {"name": "UseableSubmodules", "children": ["SubmoduleItemRef+"]},
    {"name": "SubmoduleItemRef", "attrs": ["SubmoduleItemTarget:IDRef!", "AllowedInSubslots:ValueList", "UsedInSubslots:ValueList", "FixedInSubslots:ValueList"]},
    {"name": "VirtualSubmoduleList", "children": ["VirtualSubmoduleItem+"]},
    {"name": "VirtualSubmoduleItem", "doc": "A submodule with its IO data and parameter records.", "attrs": [
      "ID:ID!", "SubmoduleIdentNumber:Unsigned32Hex!", "API:Unsigned32", "FixedInSubslots:ValueList", "MayIssueProcessAlarm:Boolean!",
      "Writeable_IM_Records:ValueList", "Max_iParameterSize:Unsigned32", "PROFIsafeSupported:Boolean"],
      "children": ["IOData", "RecordDataList?", "ModuleInfo", "Graphics?"]},
    {"name": "SubmoduleList", "children": ["SubmoduleItem+"]},
    {"name": "SubmoduleItem", "attrs": ["ID:ID!", "SubmoduleIdentNumber:Unsigned32Hex!", "API:Unsigned32", "MayIssueProcessAlarm:Boolean!", "Writeable_IM_Records:ValueList"], "children": ["IOData", "RecordDataList?", "ModuleInfo", "Graphics?"]},
    {"name": "IOData", "attrs": ["F_IO_StructureDescVersion:Unsigned8", "F_IO_StructureDescCRC:Unsigned32"], "children": ["Input?", "Output?"]},
    {"name": "Input", "attrs": ["Consistency:Consistency"], "children": ["DataItem+"]},
    {"name": "Output", "attrs": ["Consistency:Consistency"], "children": ["DataItem+"]},
    {"name": "DataItem", "attrs": ["DataType:DataType!", "TextId:IDRef!", "Length:Unsigned16", "UseAsBits:Boolean", "Subordinate:Boolean"], "children": ["BitDataItem*"]},
    {"name": "BitDataItem", "attrs": ["BitOffset:Unsigned8!", "TextId:IDRef!"]},
    {"name": "RecordDataList", "children": ["ParameterRecordDataItem*", "F_ParameterRecordDataItem?"]},
    {"name": "ParameterRecordDataItem", "doc": "A parameter record the controller writes before PrmEnd.", "attrs": ["Index:Unsigned16!", "Length:Unsigned32!", "TransferSequence:Unsigned16", "ChangeableWithBump:Boolean"], "children": ["Name", "Const*", "Ref*", "MenuList?"]},
    {"name": "Const", "attrs": ["ByteOffset:Unsigned32", "Data:string!"]},
    {"name": "Ref", "attrs": ["ValueItemTarget:IDRef", "ByteOffset:Unsigned32!", "BitOffset:Unsigned8", "BitLength:Unsigned8", "DataType:DataType!", "DefaultValue:string", "AllowedValues:string", "Changeable:Boolean", "Visible:Boolean", "TextId:IDRef!", "Length:Unsigned32", "ID:ID"]},
    {"name": "MenuList", "children": ["MenuItem+"]},
    {"name": "MenuItem", "attrs": ["ID:ID!"], "children": ["Name", "MenuRef*", "ParameterRef*"]},
    {"name": "MenuRef", "attrs": ["MenuTarget:IDRef!"]},
    {"name": "ParameterRef", "attrs": ["ParameterTarget:IDRef!"]},
    {"name": "F_ParameterRecordDataItem", "doc": "PROFIsafe parameters; preserved, not interpreted.", "attrs": ["F_ParamDescCRC:Unsigned16!", "Index:Unsigned16!", "TransferSequence:Unsigned16"]},
    {"name": "SystemDefinedSubmoduleList", "children": ["InterfaceSubmoduleItem+", "PortSubmoduleItem*"]},
    {"name": "InterfaceSubmoduleItem", "doc": "The interface submodule (subslot 0x8000) with the RT properties.", "attrs": [
      "ID:ID!", "SubslotNumber:Unsigned16", "TextId:IDRef!", "SubmoduleIdentNumber:Unsigned32Hex!", "SupportedRT_Classes:RTClasses",
      "SupportedProtocols:TokenList~", "DCP_HelloSupported:Boolean", "PTP_BoundarySupported:Boolean",
      "DCP_BoundarySupported:Boolean", "DelayMeasurementSupported:Boolean", "IsochroneModeSupported:Boolean", "Writeable_IM_Records:ValueList",
      "NetworkComponentDiagnosisSupported:Boolean", "MulticastBoundarySupported:Boolean"],
      "children": ["RT_Class3Properties?", "SynchronisationMode?", "ApplicationRelations?", "MediaRedundancy?"]},
    {"name": "ApplicationRelations", "attrs": ["StartupMode:StartupMode", "NumberOfAdditionalInputCR:Unsigned16", "NumberOfAdditionalOutputCR:Unsigned16", "NumberOfAdditionalMulticastProviderCR:Unsigned16", "NumberOfMulticastConsumerCR:Unsigned16", "PullModuleAlarmSupported:Boolean", "NumberOfAR:Unsigned16"], "children": ["TimingProperties?", "RT_Class3TimingProperties?"]},
    {"name": "TimingProperties", "attrs": ["SendClock:ValueList", "ReductionRatio:ValueList", "ReductionRatioPow2:ValueList"]},
    {"name": "RT_Class3TimingProperties", "attrs": ["SendClock:ValueList", "ReductionRatio:ValueList", "ReductionRatioPow2:ValueList"]},
    {"name": "RT_Class3Properties", "attrs": ["MaxBridgeDelay:Unsigned32!", "MaxNumberIR_FrameData:Unsigned32!", "StartupMode:StartupMode", "ForwardingMode:TokenList"]},
    {"name": "SynchronisationMode", "attrs": ["SupportedRole:TokenList", "MaxLocalJitter:Unsigned32", "T_PLL_MAX:Unsigned32", "SupportedSyncProtocols:TokenList"]},
    {"name": "MediaRedundancy", "attrs": ["SupportedRole:TokenList", "MaxMRP_Instances:Unsigned8", "AdditionalProtocolsSupported:Boolean"]},
    {"name": "PortSubmoduleItem", "doc": "A port submodule (subslot 0x8001 and up).", "attrs": [
      "ID:ID!", "SubslotNumber:Unsigned16!", "TextId:IDRef!", "SubmoduleIdentNumber:Unsigned32Hex!", "MaxPortTxDelay:Unsigned16",
      "MaxPortRxDelay:Unsigned16", "PortDeactivationSupported:Boolean", "LinkStateDiagnosisCapability:TokenList", "IsDefaultRingport:Boolean",
      "SupportsRingportConfig:Boolean", "CheckMAUTypeSupported:Boolean", "Writeable_IM_Records:ValueList", "ShortPreamble100MBitSupported:Boolean"],
      "children": ["MAUTypeList?"]},
    {"name": "MAUTypeList", "children": ["MAUTypeItem+"]},
    {"name": "MAUTypeItem", "attrs": ["Value:Unsigned16!", "AdjustSupported:Boolean", "Extension:Unsigned16"]},
    {"name": "Graphics", "children": ["GraphicItemRef+"]},
    {"name": "GraphicItemRef", "attrs": ["Type:token!", "GraphicItemTarget:IDRef!"]},
    {"name": "ModuleList", "children": ["ModuleItem+"]},
    {"name": "ModuleItem", "doc": "A module type with its submodules.", "attrs": ["ID:ID!", "ModuleIdentNumber:Unsigned32Hex!", "RequiredSchemaVersion:Version", "PhysicalSubslots:ValueList"], "children": ["ModuleInfo", "SubslotList?", "VirtualSubmoduleList?", "UseableSubmodules?", "Graphics?"]},
    {"name": "ValueList", "children": ["ValueItem+"]},
    {"name": "ValueItem", "attrs": ["ID:ID!"], "children": ["Help?", "Assignments?"]},
    {"name": "Help", "attrs": ["TextId:IDRef!"]},
    {"name": "Assignments", "children": ["Assign+"]},
    {"name": "Assign", "attrs": ["Content:string!", "TextId:IDRef!"]},
    {"name": "ChannelDiagList", "children": ["ChannelDiagItem+"]},
    {"name": "ChannelDiagItem", "doc": "The text of a ChannelErrorType.", "attrs": ["ErrorType:Unsigned16!", "MaintenanceAlarmState:TokenList"], "children": ["Name", "Help?", "ExtChannelDiagList?"]},
    {"name": "ExtChannelDiagList", "children": ["ExtChannelDiagItem+"]},
    {"name": "ExtChannelDiagItem", "attrs": ["ErrorType:Unsigned16!", "MaintenanceAlarmState:TokenList"], "children": ["Name", "Help?"]},
    {"name": "GraphicsList", "children": ["GraphicItem+"]},
    {"name": "GraphicItem", "attrs": ["ID:ID!", "GraphicFile:token!"]},
    {"name": "CategoryList", "children": ["CategoryItem+"]},
    {"name": "CategoryItem", "attrs": ["ID:ID!", "TextId:IDRef!"]},
    {"name": "ExternalTextList", "doc": "The texts all TextId attributes refer to.", "children": ["PrimaryLanguage", "Language*"]},
    {"name": "PrimaryLanguage", "children": ["Text+"]},
    {"name": "Language", "attrs": ["xml:lang:Language!"], "children": ["Text+"]},
    {"name": "Text", "attrs": ["TextId:ID!", "Value:string!"]}
  ]
}
